{
  "name": "obrtniq-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-First sustav za vođenje paušalnih i dohodovnih obrta u RH",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@obrtniq/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
